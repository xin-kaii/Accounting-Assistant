# 复制成 .env 后填入真实值。.env 已 gitignore，不会进仓库。
# 两家各有一个备选，切换时把主配置注释掉、备选取消注释即可，代码不用改。

# 文本模型（B 负责）—— 默认 DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-chat
# 备选：智谱 glm-4-flash（免费，Key 不可用时顶上）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=你的智谱key
# LLM_MODEL=glm-4-flash

# 视觉模型（C 负责）—— 默认智谱 glm-4v-flash（免费，实测可用）
VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VLM_API_KEY=你的智谱key
VLM_MODEL=glm-4v-flash
# 备选：阿里云百炼 qwen-vl-max
# VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_API_KEY=sk-你的key
# VLM_MODEL=qwen-vl-max

# 数据库
DB_PATH=data/app.db

# 调试开关：true = 不调真模型，走离线规则
USE_MOCK_LLM=false
