# 复制成 .env 后再填真实值。.env 不会进仓库。
# 需要申请两家：文本模型一家 + 视觉模型一家（互为主备）

# ---------- 文本模型（B 负责）----------
# 三选一，默认 DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-chat

# 备选 1：阿里云百炼（通义）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# 备选 2：智谱
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# ---------- 视觉模型（C 负责，识别小票/截图）----------
# 两家都走 OpenAI 兼容接口，换家只改这三行，代码不用动。
# 模型名请以你控制台里「模型列表」显示的为准，写错了会报 model not found。

# 方案 A：智谱（推荐给 C，注册通常比百炼快）
VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VLM_API_KEY=你的key
VLM_MODEL=glm-4v-plus

# 方案 B：阿里云百炼（备用，切换时把上面三行注释掉，去掉下面三行的注释）
# VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_API_KEY=sk-你的key
# VLM_MODEL=qwen-vl-max

# ---------- 数据库 ----------
DB_PATH=data/app.db

# ---------- 调试开关（B 用）----------
# true = 不调真模型，走 mock_llm 离线规则，方便没网/没额度时演示
USE_MOCK_LLM=false
